{
  "name": "portfolio-app",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://amandainnis.github.io/",
  "dependencies": {
    "d3": "^5.14.2",
    "gh-pages": "^6.3.0",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "react": "^16.14.0",
    "react-dom": "^16.14.0",
    "react-scripts": "5.0.1",
    "sass": "^1.77.8"
  },
  "scripts": {
    "predeploy": "npm run build",
    "deploy": "gh-pages -b master -d build",
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": "react-app",
    "rules": {
      "no-unused-vars": "off"
