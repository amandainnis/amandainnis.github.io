  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "nth-check": "2.1.1",
    "underscore": "1.13.8",
    "@tootallnate/once": "3.0.1",
    "serialize-javascript": "7.1.1",
    "postcss": "8.5.28"
  }
}
